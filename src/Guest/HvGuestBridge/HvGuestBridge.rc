#include "../../Shared/VmStreamVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     VMSTREAM_VERSION_CSV
 PRODUCTVERSION  VMSTREAM_VERSION_CSV
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      VMSTREAM_COMPANY_NAME
            VALUE "FileDescription",  "VMStream Guest HVSocket Audio & Touch Bridge Service"
            VALUE "FileVersion",      VMSTREAM_VERSION_STR
            VALUE "InternalName",     "HvGuestBridge"
            VALUE "OriginalFilename", "HvGuestBridge.exe"
            VALUE "ProductName",      VMSTREAM_PRODUCT_NAME
            VALUE "ProductVersion",   VMSTREAM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
